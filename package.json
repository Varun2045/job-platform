{
  "name": "job-platform",
  "version": "2.1.0",
  "description": "Open-Source AI Career Operating System",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "build": "npm --prefix frontend install --include=dev && tsc && npm --prefix frontend run build && npx playwright install chromium",
    "heroku-postbuild": "npm run build",
    "start": "node dist/server.js",
    "server": "node dist/server.js",
    "prod:start": "npm run build && npm start",
    "dev:start": "concurrently \"tsc -w\" \"node --watch dist/server.js\" \"npm run dev --prefix frontend\"",
    "monitor": "node dist/cli/admin.js monitor",
    "health": "node dist/cli/admin.js health",
    "stats": "node dist/cli/admin.js stats",
    "resume-score": "node dist/cli/admin.js resume-score",
    "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "deploy:check": "npm run lint && npm run build && npm test -- --runInBand",
    "deploy:heroku": "deploy_heroku.bat",
    "validate-classification": "node dist/cli/validateClassification.js",
    "validate-scrapers": "node dist/cli/validateScrapers.js",
    "benchmark-scrapers": "node dist/cli/benchmarkScrapers.js",
    "reclassify-jobs": "node dist/cli/reclassifyJobs.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dd-trace": "^6.8.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "newrelic": "^14.3.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.44.1",
    "resend": "^3.2.0",
    "sanitize-html": "^2.17.6",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.5.2",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5"
  }
}
