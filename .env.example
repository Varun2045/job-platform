# Server Port
PORT=3001

# Runtime Mode ('development' or 'production')
NODE_ENV=production

# Storage configuration (true to use local JSON file storage fallback, false to use Supabase)
IS_LOCAL=true

# Supabase database parameters (required if IS_LOCAL=false)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Resend API details for email digests dispatching
RESEND_API_KEY=re_your_api_key
SENDER_EMAIL=alerts@yourdomain.com
RECIPIENT_EMAIL=you@gmail.com

# Scraper run threshold configurations
MATCH_THRESHOLD=80

# Google Calendar OAuth2 credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Feature Flags
FEATURE_RESUME_MATCHING=true
FEATURE_DASHBOARD=true
FEATURE_SCREENSHOTS=true
FEATURE_PLAYWRIGHT=true
FEATURE_EMAIL=true

# Resume Matching Weights (must sum to 100)
WEIGHT_SKILLS=40
WEIGHT_TITLE=30
WEIGHT_EXPERIENCE=15
WEIGHT_LOCATION=10
WEIGHT_TFIDF=5

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local Development Credentials (only used when IS_LOCAL=true)
# WARNING: These are for local development only. Never use these in production.
LOCAL_ADMIN_EMAIL=admin@jobmonitor.com
LOCAL_ADMIN_PASSWORD=admin123
LOCAL_USER_EMAIL=user@jobmonitor.com
LOCAL_USER_PASSWORD=user123
LOCAL_VIEWER_EMAIL=viewer@jobmonitor.com
LOCAL_VIEWER_PASSWORD=viewer123
