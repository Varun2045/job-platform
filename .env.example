# Server Runtime Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database & Storage Provider Mode
# Set STORAGE_MODE to 'file' for zero-config local JSON, or 'supabase' for PostgreSQL
STORAGE_MODE=file
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_platform

# Authentication & Security Secrets (REQUIRED - minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-at-least-32-characters-long-for-security
SESSION_SECRET=super-secret-session-key-at-least-32-characters-long
ENCRYPTION_KEY=super-secret-encryption-key-at-least-32-characters-long-for-sensitive-data

# AI & LLM Providers (Zero-Fabrication Mode)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key

# Email & Notifications
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CareerOS <notifications@careeros.studio>
NOTIFICATION_EMAIL_SENDER=notifications@careeros.studio
NOTIFICATION_EMAIL_RECIPIENT=your-email@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Timeouts (milliseconds)
SUPABASE_TIMEOUT_MS=15000
JOBS_CACHE_TTL_MS=30000
PLAYWRITE_TIMEOUT_MS=30000

# Playwright Extraction Fallback Configuration
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true

# Feature Flags
FEATURE_RESUME_MATCHING=true
FEATURE_DASHBOARD=true
FEATURE_SCREENSHOTS=true
FEATURE_PLAYWRIGHT=true
FEATURE_EMAIL=true
FEATURE_EXPLAINABLE_AI=true
FEATURE_ADVANCED_TAGS=true
FEATURE_MULTI_DEPARTMENT=true
FEATURE_RULE_ENGINE=true
FEATURE_WEIGHTED_KEYWORDS=true

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://careeros.studio/auth/google/callback

# Local Development Users (Optional)
LOCAL_ADMIN_EMAIL=admin@local.dev
LOCAL_ADMIN_PASSWORD=local_admin_password_at_least_8_chars
LOCAL_USER_EMAIL=user@local.dev
LOCAL_USER_PASSWORD=local_user_password_at_least_8_chars
LOCAL_VIEWER_EMAIL=viewer@local.dev
LOCAL_VIEWER_PASSWORD=local_viewer_password_at_least_8_chars

# Matching Configuration
MATCH_THRESHOLD=0
WEIGHT_SKILLS=40
WEIGHT_TITLE=30
WEIGHT_EXPERIENCE=15
WEIGHT_LOCATION=10
WEIGHT_TFIDF=5

# Application Configuration
APP_NAME=CareerOS
APP_URL=https://careeros.studio
FRONTEND_URL=https://careeros.studio
BACKEND_URL=https://careeros.studio
CORS_ORIGIN=https://careeros.studio

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# Logging Configuration
LOG_RETENTION_DAYS=30

# Cron Security
CRON_SECRET=your-cron-secret-minimum-16-characters

# Vercel Integration (Optional)
VERCEL_TOKEN=your-vercel-api-token

# Google Calendar Integration
GOOGLE_CALENDAR_ID=primary

# Advanced Scraping Features - Redis Configuration (for Cloudflare token caching)
# Required for distributed token caching across instances
# Falls back to in-memory cache if not configured
REDIS_URL=redis://localhost:6379
# Alternative format:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# Advanced Scraping Features - CAPTCHA Solving Configuration
# Required for automatic CAPTCHA solving (2Captcha, Anti-Captcha)
# Leave empty to disable CAPTCHA solving
CAPTCHA_API_KEY=your_captcha_api_key
CAPTCHA_PROVIDER=2captcha
# Options: 2captcha, anticaptcha

# Advanced Scraping Features - Proxy Configuration
# Optional: Configure proxy pool for rotation
# Format: http://username:password@proxy-host:port
PROXY_POOL_1=http://proxy1.example.com:8080
PROXY_POOL_2=http://proxy2.example.com:8080
PROXY_POOL_3=http://proxy3.example.com:8080

# Advanced Scraping Features - Proxy Provider Authentication
# Required if using BrightData, SmartProxy, or other premium providers
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
PROXY_PROVIDER=custom
# Options: brightdata, smartproxy, custom
