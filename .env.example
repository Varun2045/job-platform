# Server Runtime Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database & Storage Provider Mode
# Set STORAGE_MODE to 'file' for zero-config local JSON, or 'supabase' for PostgreSQL
STORAGE_MODE=file
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_platform

# Authentication & Security Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production
SESSION_SECRET=super-secret-session-key-replace-in-production

# AI & LLM Providers (Zero-Fabrication Mode)
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Email & Multi-Channel Notifications
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=alerts@jobplatform.dev
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# Playwright Extraction Fallback Configuration
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true

# Developer Portfolio Vercel Cloud Deployment (Optional)
VERCEL_TOKEN=vercel_tok_your_vercel_api_token_here

